{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "buildCommand": "corepack pnpm build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/assistant", "destination": "/index.html" },
    { "source": "/assistant/", "destination": "/index.html" },
    {
      "source": "/borrowing",
      "destination": "/index.html"
    },
    {
      "source": "/borrowing/",
      "destination": "/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://runway-api-rw61.onrender.com/api/:path*"
    },
    {
      "source": "/workspace",
      "destination": "/index.html"
    },
    {
      "source": "/workspace/",
      "destination": "/index.html"
    },
    {
      "source": "/schedules/:id",
      "destination": "/index.html"
    },
    {
      "source": "/docs",
      "destination": "/index.html"
    },
    {
      "source": "/docs/",
      "destination": "/index.html"
    }
  ]
}
